          "value": true,
          "hint": {
            "en": "Shows a button on the device tile that restarts this service. Active connections are dropped.",
            "de": "Zeigt eine Schaltfläche auf der Gerätekachel, die diesen Dienst neu startet. Bestehende Verbindungen werden getrennt."
          }
        },
        {
          "id": "info_service",
          "type": "label",
          "label": {
            "en": "Service identifier",
            "de": "Dienstkennung"
          },
          "value": "-"
        }
      ]
    }
