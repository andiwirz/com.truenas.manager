      "filter": "driver_id=truenas-pool"
    },
    {
      "name": "percent",
      "type": "number",
      "title": {
        "en": "Free space (%)",
        "de": "Freier Speicher (%)"
      },
      "min": 1,
      "max": 99,
      "step": 1,
      "placeholder": {
        "en": "10",
        "de": "10"
      }
    }
  ],
  "tokens": [
    {
      "name": "free_percent",
      "type": "number",
      "title": {
        "en": "Free space (%)",
        "de": "Freier Speicher (%)"
      }
    },
    {
      "name": "free_tb",
      "type": "number",
      "title": {
        "en": "Free space (TB)",
        "de": "Freier Speicher (TB)"
      }
    }
  ]
}
