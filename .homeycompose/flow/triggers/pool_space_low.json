{
  "id": "pool_space_low",
  "title": {
    "en": "Free space dropped below",
    "de": "Freier Speicher ist gefallen unter"
  },
  "titleFormatted": {
    "en": "Free space dropped below [[percent]] %",
    "de": "Freier Speicher ist unter [[percent]] % gefallen"
  },
  "hint": {
    "en": "Fires once each time free space crosses the threshold downwards, not on every reading below it.",
    "de": "Wird jeweils einmal beim Unterschreiten des Schwellwerts ausgelöst, nicht bei jeder Messung darunter."
  },
  "args": [
    {
      "name": "device",
