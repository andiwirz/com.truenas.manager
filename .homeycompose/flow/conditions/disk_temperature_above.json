{
  "id": "disk_temperature_above",
  "title": {
    "en": "Temperature !{{is|is not}} above",
    "de": "Temperatur !{{ist|ist nicht}} über"
  },
  "titleFormatted": {
    "en": "Temperature !{{is|is not}} above [[temperature]] °C",
    "de": "Temperatur !{{ist|ist nicht}} über [[temperature]] °C"
  },
  "args": [
    {
      "name": "device",
