{
  "id": "vm_start",
  "title": {
    "en": "Start the virtual machine",
    "de": "VM starten",
    "nl": "De virtuele machine starten"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=truenas-vm"
    },
    {
      "name": "overcommit",
      "type": "dropdown",
      "title": {
        "en": "Memory",
        "de": "Arbeitsspeicher",
        "nl": "Geheugen"
      },
      "values": [
        {
          "id": "false",
          "label": {
            "en": "Require free memory",
            "de": "Freien Speicher verlangen",
            "nl": "Vrij geheugen vereisen"
          }
        },
        {
          "id": "true",
          "label": {
            "en": "Allow overcommit",
            "de": "Überbelegung erlauben",
            "nl": "Overcommit toestaan"
          }
        }
      ]
    }
  ],
  "titleFormatted": {
    "en": "Start the virtual machine, overcommit [[overcommit]]",
    "de": "VM starten, Überbelegung [[overcommit]]",
    "nl": "De virtuele machine starten, overcommit [[overcommit]]"
  },
  "hint": {
    "en": "Memory overcommitment lets the machine start even when there is not enough free memory left. Use it only when you know the host can cope.",
    "de": "Speicher-Überbelegung lässt die Maschine auch starten, wenn nicht genug freier Arbeitsspeicher vorhanden ist. Nur verwenden, wenn der Host das verkraftet.",
    "nl": "Met geheugenovercommit start de machine ook wanneer er niet genoeg vrij geheugen meer is. Gebruik dit alleen als je weet dat de host het aankan."
  }
}
